# GEMINI_API_KEY: Required for Gemini AI multimodal ticket parsing and extraction.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Required for Google Maps Platform interactive maps and routing.
# Automatically provisioned via AI Studio setup or Google Cloud project.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
